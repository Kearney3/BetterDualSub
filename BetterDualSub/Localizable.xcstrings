    "bilingual.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merge two subtitle files (.srt / .vtt) into one bilingual SRT: primary lines on top, secondary below. Cue timings that differ slightly are aligned automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把两个字幕文件（.srt / .vtt）合并为一个双语 SRT：主字幕在上，副字幕在下。时间点略有差异的字幕会自动对齐。"
          }
        }
      }
    },
    "bilingual.export" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export bilingual SRT…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出双语 SRT…"
          }
        }
      }
    },
    "bilingual.offset.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive values delay the secondary subtitle before merging. Use it if the two files come from different film versions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正值会在合并前延后副字幕；两个文件来自不同影片版本时可用来校准。"
          }
        }
      }
    },
