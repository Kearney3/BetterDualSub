    "guide.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Load subtitles and show them in a floating window. Playback can sync with TV.app or another selected player."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
