    "align.apply" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Align to current time"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对齐到当前播放时间"
          }
        }
      }
    },
    "align.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a line from either track and apply it while that line is being spoken; the delay is set automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在某句台词正在播放时，从任一轨道选中同一句字幕并应用，延迟会自动算出。"
          }
        }
      }
    },
    "align.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Example: at 10:00 you hear a line that the file shows at 8:00. Select it and apply: the delay becomes +2:00 (if the tracks are linked, both tracks move)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如：播放到 10:00 听到的台词，在字幕文件里出现在 8:00。选中它并应用，延迟就会变为 +2 分钟（两轨同步开启时，两轨一起偏移）。"
          }
        }
      }
    },
    "align.now" : {
